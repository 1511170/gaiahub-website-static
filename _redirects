# Redirecciones de Cloudflare Pages.
# Se copia tal cual a dist/ y Cloudflare la lee en el despliegue.

# Gaia Commons pasó a llamarse Gaia Union (agosto de 2026). La ruta anterior
# estaba indexada y era el destino de los enlaces del menú y del pie, así que
# se mantiene viva con un 301 para no perder el posicionamiento.
/commons     /union     301
/commons/    /union/    301
/es/commons  /es/union  301
/es/commons/ /es/union/ 301

# Gaia Vision pasó a llamarse Gaia Economy y EcoHabitats a Gaia BioHabitats
# (agosto de 2026). Mismo motivo: las rutas viejas estaban indexadas.
/vision           /economy          301
/vision/          /economy/         301
/es/vision        /es/economy       301
/es/vision/       /es/economy/      301
/ecohabitats      /biohabitats      301
/ecohabitats/     /biohabitats/     301
/es/ecohabitats   /es/biohabitats   301
/es/ecohabitats/  /es/biohabitats/  301
